@{
}
<div class="container mt-5">

    <h1 class="text-center text-primary fw-bold mb-4">
        @ViewData["Title"]
    </h1>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle fs-1 text-primary"></i>

                    <h5 class="card-title mt-3">Manager Name</h5>

                    <p class="card-text text-muted fs-5">
                        @ViewData["managerName"]
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam fs-1 text-success"></i>

                    <h5 class="card-title mt-3">Number Of Products</h5>

                    <h2 class="text-success fw-bold">
                        @ViewData["numOfProduct"]
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Our Products</h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        @foreach (string item in (string[])ViewData["Products"])
                        {
                            <div class="col-md-4">
                                <div class="border rounded p-3 text-center">
                                    <i class="bi bi-box text-primary fs-3"></i>
                                    <h6 class="mt-2 mb-0">@item</h6>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>