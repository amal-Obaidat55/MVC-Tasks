*@
@{
}

@{
    ViewData["Title"] = "Review Request";
}

<div class="container mt-4">

    <h2>Review Supply Request</h2>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Priority</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in ViewBag.Products)
            {
                <tr>
                    <td>@item[0]</td>
                    <td>@item[1]</td>
                    <td>@item[2]</td>
                    <td>@item[3]</td>
                    <td>@item[4]</td>
                    <td>@item[5]</td>
                </tr>
            }
        </tbody>

    </table>

    <hr />

    <h4>Request Summary</h4>

    <p>Subtotal: @ViewBag.SubTotal JD</p>

    <p>Preparation Fee: @ViewBag.PreparationFee JD</p>

    <p>Discount: @ViewBag.Discount JD</p>

    <h4 class="text-success">
        Final Total: @ViewBag.Total JD
    </h4>

    <form method="post" action="@Url.Action("ConfirmRequests", "SupplyRequest")">

        <button type="submit" class="btn btn-success">
            Confirm Request
        </button>

    </form>

</div>
