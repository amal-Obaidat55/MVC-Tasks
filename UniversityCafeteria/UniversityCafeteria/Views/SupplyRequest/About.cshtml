@{
}
 
@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="text-primary mb-3">About University Cafeteria</h2>

        <p>
            The University Cafeteria Supply Request Management System
            helps cafeteria employees manage their supply requests easily.
        </p>

        <h4 class="mt-3">System Features</h4>

        <ul>
            <li>Create supply requests.</li>
            <li>Add multiple products to a request.</li>
            <li>Calculate product totals and request costs.</li>
            <li>Apply preparation fees and discounts.</li>
            <li>Review and confirm supply requests.</li>
            <li>Save preferred priority using Cookies.</li>
            <li>Save draft requests using Session.</li>
            <li>View confirmed requests.</li>
        </ul>

        <h4 class="mt-3">Technologies Used</h4>

        <ul>
            <li>ASP.NET Core MVC</li>
            <li>C#</li>
            <li>HTML</li>
            <li>CSS</li>
            <li>Bootstrap</li>
        </ul>

    </div>

</div>