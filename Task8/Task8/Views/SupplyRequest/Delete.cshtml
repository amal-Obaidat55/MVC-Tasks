@model SupplyRequest
@using Task8.Models

<h2>Delete Supply Request</h2>

<p>Are you sure you want to delete this request?</p>

<p><strong>Request ID:</strong> @Model.Id</p>
<p><strong>Date:</strong> @Model.RequestDate</p>
<p><strong>Total Price:</strong> @Model.TotalPrice</p>
<p><strong>Status:</strong> @Model.Status</p>

<form method="post" action="/SupplyRequest/DeleteConfirmed/@Model.Id">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="/SupplyRequest/Index" class="btn btn-secondary">Cancel</a>
</form>