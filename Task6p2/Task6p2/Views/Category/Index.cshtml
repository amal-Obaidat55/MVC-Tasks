@model List<Category>

<a href=@Url.Action("Create","Category") class="btn btn-dark" >Add New Category</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Count</th>
            <th scope="col">Actions</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@category.Products.Count</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-dark">Edit</a>
                        <a asp-controller="Category" asp-action="Details" asp-route-id="@category.Id" class="btn btn-dark">Details</a>
                        <form metod="post" action=@Url.Action("Delete", "Category", new { id = category.Id })>
                            <button type="submit" class="btn btn-dark" style="display:inline-block;"
                                    onclick="return confirm('Are you sure you want to delete this user?')">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
                
            </tr>

        }
    </tbody>
</table>
