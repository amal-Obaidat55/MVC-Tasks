@model List<Supplier>

<a href=@Url.Action("Create","Supplier") class="btn btn-dark" >Add New Supplier</a>
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Phone</th>
            <th scope="col">Email</th>
            <th scope="col">Address</th>
            <th scope="col">Count</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supply in Model)
        {
            <tr>
                <td>@supply.Id</td>
                <td>@supply.Name</td>
                <td>@supply.Phone</td>
                <td>@supply.Email</td>
                <td>@supply.Address</td>
                <td>@supply.Products.Count</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@supply.Id" class="btn btn-dark">Edit</a>
                        <a asp-controller="Supplier" asp-action="Details" asp-route-id="@supply.Id" class="btn btn-dark">Details</a>
                        <form metod="post" action=@Url.Action("Delete", "Supplier", new { id = supply.Id })>
                            <button type="submit" class="btn btn-dark" style="display:inline-block;"
                                    onclick="return confirm('Are you sure you want to delete this user?')">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>