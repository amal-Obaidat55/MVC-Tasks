@model List<Employee>

<a href=@Url.Action("Create","Employee") class="btn btn-dark" >Add New Employee</a>
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Phone</th>
            <th scope="col">Email</th>
            <th scope="col">Position</th>
            <th scope="col">Salary</th>
            <th scope="col">HireDate</th>
            <th scope="col">Count</th>
            <th scope="col">Actions</th>
            

        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>@employee.Phone</td>
                <td>@employee.Email</td>
                <td>@employee.Position</td>
                <td>@employee.Salary</td>
                <td>@employee.HireDate</td>
                <td>@employee.Order1s.Count</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-dark">Edit</a>
                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-dark">Details</a>
                        <form metod="post" action=@Url.Action("Delete", "Employee", new { id = employee.Id })>
                            <button type="submit" class="btn btn-dark" style="display:inline-block;"
                                    onclick="return confirm('Are you sure you want to delete this user?')">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
                
            </tr>

        }
    </tbody>
</table>
