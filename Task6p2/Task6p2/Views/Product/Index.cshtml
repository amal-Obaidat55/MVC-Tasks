@model List<Product>
<a href=@Url.Action("Create","Product") class="btn btn-dark" >Add New Product</a>
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Supplier ID</th>
            <th scope="col">Category ID</th>
            <th scope="col">Actions</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Description</td>
                <td>@product.Quantity</td>
                <td>@product.SupplierId</td>
                <td>@product.CategoryId</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-dark">Edit</a>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-dark">Details</a>
                        <form metod="post" action=@Url.Action("Delete", "Product", new { id = product.Id })>
                            <button type="submit" class="btn btn-dark" style="display:inline-block;"
                                    onclick="return confirm('Are you sure you want to delete this user?')">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }

        
    </tbody>
</table>
<br />
<br />
<h1>
    Products With Quantity less than 5
</h1>
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Supplier ID</th>
            <th scope="col">Category ID</th>
            <th scope="col">Actions</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            if(product.Quantity < 5)
            {
                <tr>
                  <td>@product.Id</td>
                  <td>@product.Name</td>
                  <td>@product.Price</td>
                  <td>@product.Description</td>
                  <td>@product.Quantity</td>
                  <td>@product.SupplierId</td>
                  <td>@product.CategoryId</td>
                  <td>
                    <div class="d-flex gap-2">

                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-dark">Edit</a>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-dark">Details</a>
                        <form metod="post" action=@Url.Action("Delete", "Product", new { id = product.Id })>
                            <button type="submit" class="btn btn-dark" style="display:inline-block;"
                            onclick="return confirm('Are you sure you want to delete this user?')">
                             Delete
                            </button>
                       </form>
                   </div>
                </td>
            </tr>
            }
            
        }

        
    </tbody>
</table>