@model Product

<form method="post" action=@Url.Action("Edit","Product") >
    <label>Name</label><br />
    <input type="text" name="Name" value="@Model.Name"/>
    <br />
    <br />
    <label>Description</label><br />
    <input type="text" name="Description" value="@Model.Description" />
    <br />
    <br />
    <label>Price</label><br />
    <input type="text" name="Price" value="@Model.Price" />
    <br />
    <br />
    <label>Quantity</label><br />
    <input type="text" name="Quantity" value="@Model.Quantity" />
    <br />
    <br />
    <label>Category ID</label><br />
    <input type="text" name="CategoryId" value="@Model.CategoryId" />
    <br />
    <br />
    <label>Supplier ID</label><br />
    <input type="text" name="SupplierId" value="@Model.SupplierId" />
    <br />
    <br />
    <button type="submit">Edit </button>
</form>
